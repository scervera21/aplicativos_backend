### ==============================================================================
### SegApp API v1 - Archivo de Pruebas REST Client (.http)
### Uso: Instala la extensión "REST Client" o "Thunder Client" en VS Code.
### Haz clic en "Send Request" sobre cada bloque.
### ==============================================================================

@baseUrl = http://127.0.0.1:8000/api/v1
@contentType = application/json

### ------------------------------------------------------------------------------
### 1. AUTENTICACIÓN
### ------------------------------------------------------------------------------

### 1.1 Iniciar Sesión (Login) y Capturar Token
# @name login
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}

{
    "username": "admin",
    "password": "password"
}

### Guardamos el token de la respuesta para las siguientes peticiones:
@authToken = {{login.response.body.token}}

### 1.2 Obtener Usuario Actual (Me)
GET {{baseUrl}}/auth/me HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### 1.3 Refrescar Token JWT
POST {{baseUrl}}/auth/refresh HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### 1.4 Cierre de Sesión (Logout)
### (Ejecutar al final de las pruebas, ya que invalida el token)
# POST {{baseUrl}}/auth/logout HTTP/1.1
# Accept: {{contentType}}
# Authorization: Bearer {{authToken}}


### ------------------------------------------------------------------------------
### 2. MÓDULO: GERENCIAS
### ------------------------------------------------------------------------------

### 2.1 Listar Gerencias
GET {{baseUrl}}/gerencias HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### 2.2 Crear una Gerencia de Prueba
# @name createGerencia
POST {{baseUrl}}/gerencias/create-gerencia HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "nombre_gerencia": "Gerencia de Pruebas Automatizadas",
    "sigla": "GPA"
}

@gerenciaId = {{createGerencia.response.body.data.id}}

### 2.3 Actualizar Gerencia
PUT {{baseUrl}}/gerencias/{{gerenciaId}}/update-gerencia HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "nombre_gerencia": "Gerencia de Pruebas Actualizada",
    "sigla": "GPA-MOD"
}

### 2.4 Eliminar Gerencia
DELETE {{baseUrl}}/gerencias/{{gerenciaId}} HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}


### ------------------------------------------------------------------------------
### 3. MÓDULO: ROLES Y PERMISOS
### ------------------------------------------------------------------------------

### 3.1 Listar Roles
GET {{baseUrl}}/roles HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### 3.2 Crear Rol
# @name createRol
POST {{baseUrl}}/roles/create-rol HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "name": "AUDITOR_TEST",
    "permissions": [
        "ver.roles",
        "ver.usuarios",
        "ver.aplicativos",
        "ver.actividades"
    ]
}

@roleId = {{createRol.response.body.data.id}}

### 3.3 Ver Permisos de un Rol
GET {{baseUrl}}/roles/{{roleId}}/permisos HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### 3.4 Actualizar Rol
PUT {{baseUrl}}/roles/{{roleId}}/update-rol HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "name": "AUDITOR_TEST_EDITADO",
    "permissions": [
        "ver.roles",
        "ver.usuarios"
    ]
}

### 3.5 Eliminar Rol
DELETE {{baseUrl}}/roles/{{roleId}} HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}


### ------------------------------------------------------------------------------
### 4. MÓDULO: USUARIOS
### ------------------------------------------------------------------------------

### 4.1 Listar Usuarios
GET {{baseUrl}}/usuarios HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### 4.2 Crear Usuario
# @name createUser
POST {{baseUrl}}/usuarios/create-user HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "username": "usuario_test",
    "first_name": "Usuario",
    "last_name": "Prueba",
    "email": "usuario_test@cantv.com",
    "password": "Password123*",
    "gerencia_id": 1,
    "is_active": true,
    "roles": ["colaborador"]
}

@userId = {{createUser.response.body.data.id}}

### 4.3 Actualizar Usuario
PUT {{baseUrl}}/usuarios/{{userId}}/update-usuario HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "first_name": "Usuario Actualizado",
    "last_name": "Prueba Mod",
    "is_active": true
}

### 4.4 Eliminar Usuario
DELETE {{baseUrl}}/usuarios/{{userId}} HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}


### ------------------------------------------------------------------------------
### 5. MÓDULO: APLICATIVOS
### ------------------------------------------------------------------------------

### 5.1 Listar Aplicativos
GET {{baseUrl}}/aplicativos HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### 5.2 Crear Aplicativo
# @name createApp
POST {{baseUrl}}/aplicativos/create-aplicativo HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "nombre_aplicativo": "App Test Automatizada",
    "alias": "TESTAPP",
    "responsable": "Ing. Carlos Mendoza",
    "pap": true,
    "estatus": "EN DESARROLLO",
    "descripcion": "Aplicativo para pruebas de integración continua",
    "lenguajes_frontend": "Vue 3, TailwindCSS",
    "lenguajes_backend": "PHP 8.2, Laravel 10",
    "bases_datos": "PostgreSQL",
    "fecha_inicio": "2026-11-01",
    "fecha_fin": "2026-12-31",
    "observaciones": "Creado durante pruebas automatizadas",
    "gerencia_id": 1
}

@appId = {{createApp.response.body.data.id}}

### 5.3 Ver Detalles del Aplicativo
GET {{baseUrl}}/aplicativos/{{appId}}/detalles HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### 5.4 Actualizar Aplicativo
PUT {{baseUrl}}/aplicativos/{{appId}}/update-aplicativo HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "nombre_aplicativo": "App Test Automatizada Mod",
    "alias": "TESTAPP2",
    "estatus": "EN PRODUCCION",
    "descripcion": "Descripción actualizada de prueba"
}

### 5.5 Eliminar Aplicativo
### (Nota: Eliminar después de probar Actividades)
# DELETE {{baseUrl}}/aplicativos/{{appId}} HTTP/1.1
# Accept: {{contentType}}
# Authorization: Bearer {{authToken}}


### ------------------------------------------------------------------------------
### 6. MÓDULO: ACTIVIDADES
### ------------------------------------------------------------------------------

### 6.1 Listar Actividades
GET {{baseUrl}}/actividades HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### 6.2 Crear Actividad
# @name createActividad
POST {{baseUrl}}/actividades/create-actividad HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "nombre_actividad": "Actividad de Prueba Backend",
    "aplicativo_id": 1,
    "area_id": 1,
    "prioridad": "ALTA",
    "porcentaje": 25,
    "fecha_creacion": "2026-11-01",
    "fecha_culminacion": "2026-11-30",
    "estado": "PENDIENTE",
    "completado": false,
    "comentarios": "Primera tarea de verificación de endpoints",
    "gerencias_colaboradoras": [1]
}

@actividadId = {{createActividad.response.body.data.id}}

### 6.3 Actualizar Porcentaje en Tiempo Real
PUT {{baseUrl}}/actividades/{{actividadId}}/porcentaje HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "porcentaje": 80
}

### 6.4 Actualizar Actividad Completa
PUT {{baseUrl}}/actividades/{{actividadId}}/update-actividad HTTP/1.1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

{
    "nombre_actividad": "Actividad de Prueba Backend Modificada",
    "prioridad": "MEDIA",
    "estado": "CULMINADO",
    "completado": true,
    "comentarios": "Tarea concluida con éxito"
}

### 6.5 Eliminar Actividad
DELETE {{baseUrl}}/actividades/{{actividadId}} HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

### Limpieza: Eliminar Aplicativo creado para pruebas
DELETE {{baseUrl}}/aplicativos/{{appId}} HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{authToken}}

